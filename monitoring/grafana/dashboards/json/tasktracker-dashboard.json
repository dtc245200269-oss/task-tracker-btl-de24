          "refId": "A"
        }
      ],
      "title": "Tần Suất HTTP Requests Theo Endpoint & Status Code (req/s)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
